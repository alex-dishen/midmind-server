generator kysely {
  provider = "ts-node ./src/db/prisma-schema-to-db-types.ts"
  output   = "../src/db/types/db.types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
}

enum UserProvider {
  GOOGLE
}

enum MessageSender {
  SYSTEM
  USER
}

model User {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String        @unique
  first_name  String
  last_name   String
  avatar      String?
  password    String? // Null when added with google or other providers
  provider    UserProvider?
  provider_id String?
  created_at  DateTime      @default(now())
  updated_at  DateTime?     @updatedAt

  user_chats    Chat[]
  sent_messages Message[]

  @@map("users")
}

model Chat {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String? // Null for first messages
  created_at DateTime @default(now())
  user_id    String   @db.Uuid

  // Chat metadata
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  user     User      @relation(fields: [user_id], references: [id])
  messages Message[]

  @@index([user_id], map: "chat_user_id_idx")
  @@map("chats")
}

model Message {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content             String
  type                MessageType   @default(TEXT)
  chat_id             String        @db.Uuid
  user_id             String?       @db.Uuid
  llm_model           String? // Null when a user sends a message
  sender_type         MessageSender
  parent_message_id   String?       @db.Uuid // Previous ai message id
  response_message_id String?       @db.Uuid // Message id ai gave a response to

  // Message metadata
  created_at DateTime @default(now())

  chat                  Chat      @relation(fields: [chat_id], references: [id])
  user                  User?     @relation(fields: [user_id], references: [id])
  previousAiMessage     Message?  @relation("PreviousAiMessage", fields: [parent_message_id], references: [id])
  userMessageResponseTo Message?  @relation("UserMessageResponse", fields: [response_message_id], references: [id])
  nextAiMessages        Message[] @relation("PreviousAiMessage")
  userMessageResponses  Message[] @relation("UserMessageResponse")

  @@index([chat_id], map: "message_chat_id_idx")
  @@map("messages")
}
